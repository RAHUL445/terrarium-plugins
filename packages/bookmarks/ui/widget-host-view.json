{
  "state": {},
  "body": {
    "type": "data-view",
    "query": "host_bookmarks",
    "config": {
      "layout": "{{$config.layout}}",
      "density": "{{$config.density}}",
      "fields": "{{$config.fields}}",
      "filters": {
        "q": "{{$config.q}}",
        "project": "{{$config.project}}",
        "tag": "{{$config.tag}}"
      }
    }
  },
  "home": {
    "hidden": true
  },
  "rail": {
    "default": false
  },
  "page": {
    "size": {
      "default": [
        6,
        4
      ],
      "min": [
        3,
        2
      ],
      "max": [
        12,
        8
      ]
    },
    "config": {
      "layout": {
        "type": "enum",
        "label": "Layout",
        "values": [
          "list",
          "table"
        ],
        "labels": [
          "List",
          "Table"
        ],
        "default": "list"
      },
      "density": {
        "type": "enum",
        "label": "Density",
        "values": [
          "comfortable",
          "compact"
        ],
        "labels": [
          "Comfortable",
          "Compact"
        ],
        "default": "comfortable"
      },
      "fields": {
        "type": "enum",
        "label": "Visible fields",
        "values": [
          "title,host,project,tags_label,visits,created_at,pinned",
          "title,host,project,tags_label",
          "title,host,created_at"
        ],
        "labels": [
          "Full details",
          "Title, site, project, and tags",
          "Title, site, and date"
        ],
        "default": "title,host,project,tags_label,visits,created_at,pinned"
      },
      "q": {
        "type": "text",
        "label": "Search bookmarks",
        "default": ""
      },
      "project": {
        "type": "text",
        "label": "Project",
        "default": ""
      },
      "tag": {
        "type": "text",
        "label": "Tag",
        "default": ""
      }
    }
  }
}
