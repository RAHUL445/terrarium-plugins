{
  "state": {
    "feed_id": "",
    "unread": false
  },
  "body": {
    "type": "stack",
    "gap": 12,
    "children": [
      {
        "type": "heading",
        "text": "Feeds"
      },
      {
        "type": "form",
        "inline": true,
        "submit_label": "Add feed",
        "submit": {
          "op": "add",
          "args": {
            "url": "{{form.url}}"
          },
          "reset": true
        },
        "children": [
          {
            "type": "text-field",
            "name": "url",
            "label": "Feed URL",
            "placeholder": "https://\u2026",
            "required": true
          }
        ]
      },
      {
        "type": "text",
        "tone": "muted",
        "text": "Feeds can reach any public website, including sites you have not added. Only HTTPS feed addresses are supported."
      },
      {
        "type": "stack",
        "direction": "row",
        "children": [
          {
            "type": "button",
            "label": "Refresh",
            "action": {
              "op": "refresh"
            }
          },
          {
            "type": "button",
            "label": "Mark all read",
            "action": {
              "op": "mark_all_read",
              "args": {
                "feed_id": "{{state.feed_id}}"
              }
            }
          }
        ]
      },
      {
        "type": "stack",
        "direction": "row",
        "gap": 12,
        "wrap": true,
        "children": [
          {
            "type": "select",
            "bind": "state.feed_id",
            "label": "Feed",
            "options": [
              {
                "value": "",
                "label": "All feeds"
              }
            ],
            "options_query": {
              "query": "feeds",
              "value": "id",
              "label": "title"
            }
          },
          {
            "type": "select",
            "bind": "state.unread",
            "label": "Read status",
            "options": [
              {
                "value": false,
                "label": "All articles"
              },
              {
                "value": true,
                "label": "Unread"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "title": "Manage feeds",
        "collapsible": true,
        "children": [
          {
            "type": "list",
            "query": "feeds",
            "item": {
              "type": "item",
              "title": "{{row.title}}",
              "subtitle": "{{row.last_error}}",
              "trailing": [
                {
                  "type": "button",
                  "label": "Remove",
                  "variant": "ghost",
                  "action": {
                    "op": "remove",
                    "args": {
                      "id": "{{row.id}}"
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "type": "list",
        "query": "items",
        "group": "feed_title",
        "params": {
          "feed_id": "{{state.feed_id}}",
          "unread": "{{state.unread}}"
        },
        "empty": "No items yet.",
        "item": {
          "type": "item",
          "title": "{{row.title}}",
          "subtitle": "{{row.summary}}",
          "action": {
            "open": "{{row.link}}"
          },
          "chips": [
            {
              "text": "{{row.published_ms}}",
              "format": "date",
              "icon": "clock"
            }
          ],
          "trailing": [
            {
              "type": "button",
              "label": "{{row.read_label}}",
              "variant": "ghost",
              "action": {
                "op": "mark_read",
                "args": {
                  "id": "{{row.id}}",
                  "read": "{{!row.read}}"
                }
              }
            }
          ],
          "read": "{{row.read}}"
        }
      }
    ]
  }
}
