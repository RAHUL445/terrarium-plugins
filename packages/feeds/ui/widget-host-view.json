{
  "state": {},
  "body": {
    "type": "data-view",
    "query": "host_unread",
    "config": {
      "layout": "{{$config.layout}}",
      "density": "{{$config.density}}",
      "fields": "{{$config.fields}}",
      "filters": {
        "unread": "{{$config.unread}}"
      }
    }
  },
  "home": {
    "hidden": true
  },
  "rail": {
    "default": false
  },
  "page": {
    "size": {
      "default": [
        6,
        4
      ],
      "min": [
        3,
        2
      ],
      "max": [
        12,
        8
      ]
    },
    "config": {
      "layout": {
        "type": "enum",
        "label": "Layout",
        "values": [
          "list",
          "table"
        ],
        "labels": [
          "List",
          "Table"
        ],
        "default": "list"
      },
      "density": {
        "type": "enum",
        "label": "Density",
        "values": [
          "comfortable",
          "compact"
        ],
        "labels": [
          "Comfortable",
          "Compact"
        ],
        "default": "comfortable"
      },
      "fields": {
        "type": "enum",
        "label": "Visible fields",
        "values": [
          "title,feed_title,published_ms,summary",
          "title,feed_title,published_ms",
          "title,published_ms"
        ],
        "labels": [
          "Article, feed, date, and summary",
          "Article, feed, and date",
          "Article and date"
        ],
        "default": "title,feed_title,published_ms,summary"
      },
      "unread": {
        "type": "boolean",
        "label": "Unread only",
        "default": true
      }
    }
  }
}
