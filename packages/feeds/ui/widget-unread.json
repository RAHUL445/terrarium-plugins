{
  "state": {},
  "body": {
    "type": "list",
    "query": "unread",
    "empty": "No unread items.",
    "item": {
      "type": "item",
      "title": "{{row.title}}",
      "subtitle": "{{row.summary}}",
      "action": {
        "open": "{{row.link}}"
      },
      "chips": [
        {
          "text": "{{row.feed_title}}"
        },
        {
          "text": "{{row.published_ms}}",
          "format": "datetime",
          "icon": "clock"
        }
      ],
      "trailing": [
        {
          "type": "button",
          "label": "{{row.read_label}}",
          "variant": "ghost",
          "action": {
            "op": "mark_read",
            "args": {
              "id": "{{row.id}}",
              "read": "{{!row.read}}"
            }
          }
        }
      ]
    }
  },
  "page": {
    "size": {
      "default": [
        6,
        4
      ],
      "min": [
        3,
        2
      ],
      "max": [
        12,
        8
      ]
    }
  }
}
