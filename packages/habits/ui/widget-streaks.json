{
  "state": {},
  "body": {
    "type": "list",
    "query": "day_summary",
    "params": {
      "today": "{{$today}}"
    },
    "item": {
      "type": "stack",
      "gap": 8,
      "children": [
        {
          "type": "text",
          "tone": "muted",
          "if": "{{!row.habits}}",
          "text": "No habits yet. Open Habits to add one."
        },
        {
          "type": "stack",
          "if": "{{row.habits}}",
          "gap": 8,
          "children": [
            {
              "type": "calendar-heatmap",
              "query": "heatmap",
              "params": {
                "today": "{{$today}}",
                "id": ""
              },
              "weeks": 12,
              "label": "Habits completed per day, last 12 weeks"
            },
            {
              "type": "text",
              "if": "{{row.top_streak}}",
              "tone": "muted",
              "text": "Best run now: {{row.top_streak}}"
            }
          ]
        }
      ]
    }
  },
  "home": {
    "order": 70,
    "collapsed": true
  },
  "page": {
    "size": {
      "default": [
        6,
        5
      ],
      "min": [
        4,
        4
      ],
      "max": [
        12,
        8
      ]
    }
  }
}
