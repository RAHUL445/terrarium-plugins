{
 "state": {
  "open": "",
  "tab": "reports",
  "create": "",
  "skill": "",
  "newskill": "",
  "schedule": "",
  "newschedule": ""
 },
 "body": {
  "type": "stack",
  "gap": 16,
  "children": [
   {
    "type": "heading",
    "text": "Reports"
   },
   {
    "type": "tabs",
    "bind": "state.tab",
    "label": "Show",
    "options": [
     {
      "value": "reports",
      "label": "Reports"
     },
     {
      "value": "skills",
      "label": "Skills"
     },
     {
      "value": "schedules",
      "label": "Schedules"
     }
    ]
   },
   {
    "type": "stack",
    "if": "{{state.tab == reports}}",
    "direction": "row",
    "wrap": true,
    "gap": 20,
    "align": "start",
    "children": [
     {
      "type": "stack",
      "grow": 3,
      "basis": 420,
      "gap": 16,
      "children": [
       {
        "type": "stack",
        "gap": 2,
        "children": [
         {
          "type": "heading",
          "level": 2,
          "text": "Your reports"
         },
         {
          "type": "list",
          "query": "summary",
          "item": {
           "type": "text",
           "text": "{{row.label}}",
           "tone": "muted"
          }
         }
        ]
       },
       {
        "type": "list",
        "query": "latest",
        "layout": "plain",
        "params": {
         "today": "{{$today}}"
        },
        "empty": "No reports yet. Make one for this week to see how it’s going; a new one is made every Sunday at 18:00.",
        "item": {
         "type": "card",
         "children": [
          {
           "type": "stack",
           "direction": "row",
           "align": "center",
           "gap": 12,
           "wrap": true,
           "children": [
            {
             "type": "stack",
             "gap": 2,
             "grow": 1,
             "children": [
              {
               "type": "heading",
               "level": 2,
               "text": "{{row.title}}"
              },
              {
               "type": "text",
               "tone": "muted",
               "text": "{{row.label}}"
              }
             ]
            },
            {
             "type": "button",
             "label": "Refresh",
             "icon": "repeat",
             "variant": "ghost",
             "if": "{{row.stale}}",
             "aria_label": "Refresh {{row.title}}",
             "action": {
              "op": "generate",
              "args": {
               "id": "{{row.id}}"
              },
              "success": "{{result.message}}"
             }
            },
            {
             "type": "button",
             "label": "Open",
             "aria_label": "Open {{row.title}}",
             "action": {
              "set": {
               "state.open": "{{row.id}}"
              }
             }
            }
           ]
          },
          {
           "type": "text",
           "if": "{{row.has_ai}}",
           "tone": "muted",
           "text": "{{row.draft_note}}"
          },
          {
           "type": "stack",
           "direction": "row",
           "gap": 20,
           "wrap": true,
           "children": [
            {
             "type": "stat",
             "label": "Tasks done",
             "value": "{{row.tasks_done}}",
             "note": "{{row.tasks_note}}",
             "tone": "{{row.tasks_tone}}"
            },
            {
             "type": "stat",
             "if": "{{row.has_habits}}",
             "label": "Habits kept",
             "value": "{{row.habits_value}}",
             "note": "{{row.habits_note}}",
             "tone": "{{row.habits_tone}}"
            },
            {
             "type": "stat",
             "label": "New notes",
             "value": "{{row.notes_count}}",
             "note": "{{row.notes_note}}",
             "tone": "{{row.notes_tone}}"
            }
           ]
          },
          {
           "type": "bar",
           "if": "{{row.detailed}}",
           "layout": "columns",
           "query": "daily",
           "params": {
            "id": "{{row.id}}"
           },
           "label": "label",
           "value": "count",
           "title": "title"
          },
          {
           "type": "list",
           "query": "highlights",
           "layout": "plain",
           "params": {
            "id": "{{row.id}}"
           },
           "item": {
            "type": "text",
            "text": "{{row.text}}",
            "tone": "muted"
           }
          }
         ]
        }
       },
       {
        "type": "section",
        "title": "All reports",
        "children": [
         {
          "type": "list",
          "query": "list",
          "params": {
           "today": "{{$today}}"
          },
          "empty": "Reports you make show up here.",
          "item": {
           "type": "item",
           "title": "{{row.title}}",
           "subtitle": "{{row.label}}",
           "action": {
            "set": {
             "state.open": "{{row.id}}"
            }
           },
           "chips": [
            {
             "text": "{{row.draft_chip}}",
             "icon": "sparkle",
             "tone": "{{row.draft_tone}}"
            },
            {
             "text": "{{row.tasks_chip}}",
             "icon": "check"
            },
            {
             "text": "{{row.habits_chip}}",
             "icon": "flame"
            },
            {
             "text": "{{row.notes_chip}}",
             "icon": "note"
            },
            {
             "text": "{{row.reflected_chip}}",
             "icon": "edit",
             "tone": "accent"
            },
            {
             "text": "{{row.stale_chip}}",
             "icon": "clock"
            }
           ]
          }
         }
        ]
       }
      ]
     },
     {
      "type": "stack",
      "grow": 1,
      "basis": 260,
      "gap": 16,
      "children": [
       {
        "type": "card",
        "children": [
         {
          "type": "heading",
          "level": 2,
          "text": "New report"
         },
         {
          "type": "button",
          "label": "Create report…",
          "icon": "plus",
          "variant": "primary",
          "action": {
           "set": {
            "state.create": "builtin:manager"
           }
          }
         },
         {
          "type": "text",
          "tone": "muted",
          "text": "Pick dates, what data to use, and a skill for how AI should write it: for your manager, a junior, or yourself."
         },
         {
          "type": "section",
          "title": "Quick, without AI",
          "collapsible": true,
          "children": [
           {
            "type": "stack",
            "direction": "row",
            "gap": 8,
            "wrap": true,
            "children": [
             {
              "type": "button",
              "variant": "chip",
              "label": "This week",
              "action": {
               "op": "generate",
               "args": {
                "period": "week"
               },
               "success": "{{result.message}}",
               "then": {
                "state.open": "{{result.id}}"
               }
              }
             },
             {
              "type": "button",
              "variant": "chip",
              "label": "Last week",
              "action": {
               "op": "generate",
               "args": {
                "period": "last_week"
               },
               "success": "{{result.message}}",
               "then": {
                "state.open": "{{result.id}}"
               }
              }
             },
             {
              "type": "button",
              "variant": "chip",
              "label": "Last 7 days",
              "action": {
               "op": "generate",
               "args": {
                "period": "7d"
               },
               "success": "{{result.message}}",
               "then": {
                "state.open": "{{result.id}}"
               }
              }
             },
             {
              "type": "button",
              "variant": "chip",
              "label": "This month",
              "action": {
               "op": "generate",
               "args": {
                "period": "month"
               },
               "success": "{{result.message}}",
               "then": {
                "state.open": "{{result.id}}"
               }
              }
             },
             {
              "type": "button",
              "variant": "chip",
              "label": "Last month",
              "action": {
               "op": "generate",
               "args": {
                "period": "last_month"
               },
               "success": "{{result.message}}",
               "then": {
                "state.open": "{{result.id}}"
               }
              }
             }
            ]
           },
           {
            "type": "section",
            "title": "Pick dates",
            "collapsible": true,
            "children": [
             {
              "type": "form",
              "submit": {
               "op": "generate",
               "args": {
                "period": "custom",
                "start": "{{form.start}}",
                "end": "{{form.end}}"
               },
               "success": "{{result.message}}",
               "then": {
                "state.open": "{{result.id}}"
               }
              },
              "submit_label": "Make report",
              "children": [
               {
                "type": "date",
                "name": "start",
                "label": "From",
                "required": true
               },
               {
                "type": "date",
                "name": "end",
                "label": "To",
                "required": true
               }
              ]
             }
            ]
           }
          ]
         },
         {
          "type": "text",
          "tone": "muted",
          "text": "Making a report for the same dates again refreshes it and keeps what you wrote."
         }
        ]
       },
       {
        "type": "card",
        "children": [
         {
          "type": "heading",
          "level": 2,
          "text": "Tasks done per week"
         },
         {
          "type": "bar",
          "layout": "columns",
          "query": "trend",
          "label": "label",
          "value": "tasks_done",
          "title": "title",
          "empty": "Weekly reports build this chart."
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "stack",
    "if": "{{state.tab == skills}}",
    "gap": 16,
    "children": [
     {
      "type": "stack",
      "direction": "row",
      "align": "center",
      "justify": "between",
      "wrap": true,
      "gap": 12,
      "children": [
       {
        "type": "text",
        "tone": "muted",
        "text": "A skill tells AI how to write a report and for whom. Starters come with the plugin; edit them or add your own.",
        "grow": 1,
        "basis": 260
       },
       {
        "type": "button",
        "label": "New skill",
        "icon": "plus",
        "variant": "primary",
        "action": {
         "set": {
          "state.newskill": "1"
         }
        }
       }
      ]
     },
     {
      "type": "list",
      "query": "skills",
      "layout": "plain",
      "empty": "No skills. Add one.",
      "item": {
       "type": "card",
       "children": [
        {
         "type": "stack",
         "direction": "row",
         "align": "center",
         "gap": 12,
         "wrap": true,
         "children": [
          {
           "type": "stack",
           "gap": 2,
           "grow": 1,
           "children": [
            {
             "type": "heading",
             "level": 2,
             "text": "{{row.name}}"
            },
            {
             "type": "text",
             "tone": "muted",
             "text": "{{row.kind}} · {{row.period_label}} · {{row.sources_label}}"
            }
           ]
          },
          {
           "type": "button",
           "label": "Use",
           "icon": "sparkle",
           "aria_label": "Create a report with {{row.name}}",
           "action": {
            "set": {
             "state.create": "{{row.id}}"
            }
           }
          },
          {
           "type": "button",
           "label": "Edit",
           "aria_label": "Edit {{row.name}}",
           "action": {
            "set": {
             "state.skill": "{{row.id}}"
            }
           }
          }
         ]
        },
        {
         "type": "text",
         "tone": "muted",
         "text": "{{row.prompt}}"
        }
       ]
      }
     },
     {
      "type": "sheet",
      "bind": "state.skill",
      "size": "large",
      "title": "Edit skill",
      "query": "skill",
      "params": {
       "id": "{{state.skill}}"
      },
      "children": [
       {
        "type": "form",
        "submit_label": "Save skill",
        "submit": {
         "op": "save_skill",
         "args": {
          "id": "{{row.id}}",
          "name": "{{form.name}}",
          "prompt": "{{form.prompt}}",
          "period": "{{form.period}}",
          "sources": "{{form.sources}}",
          "tags": "{{form.tags}}",
          "model": "{{form.model}}"
         },
         "success": "{{result.message}}",
         "then": {
          "state.skill": ""
         }
        },
        "children": [
         {
          "type": "text-field",
          "name": "name",
          "label": "Name",
          "required": true,
          "value": "{{row.name}}",
          "placeholder": "e.g. Update for my manager"
         },
         {
          "type": "text-area",
          "name": "prompt",
          "label": "What the AI should write",
          "rows": 9,
          "required": true,
          "value": "{{row.prompt}}",
          "placeholder": "Who it is for, the sections, tone and length. The data comes from the report; the AI is told never to invent anything."
         },
         {
          "type": "stack",
          "direction": "row",
          "gap": 12,
          "wrap": true,
          "children": [
           {
            "type": "select",
            "name": "period",
            "label": "Usual range",
            "value": "{{row.period}}",
            "options": [
             {
              "value": "",
              "label": "This week so far"
             },
             {
              "value": "last_week",
              "label": "Last week"
             },
             {
              "value": "7d",
              "label": "Last 7 days"
             },
             {
              "value": "month",
              "label": "This month so far"
             },
             {
              "value": "last_month",
              "label": "Last month"
             }
            ],
            "grow": 1,
            "basis": 180
           },
           {
            "type": "text-field",
            "name": "tags",
            "label": "Only tasks tagged",
            "value": "{{row.tags}}",
            "placeholder": "Blank: all",
            "grow": 1,
            "basis": 180
           }
          ]
         },
         {
          "type": "choice",
          "name": "sources",
          "label": "Data it uses",
          "multiple": true,
          "value": "{{row.sources}}",
          "options": [
           {
            "value": "tasks",
            "label": "Done tasks"
           },
           {
            "value": "task_notes",
            "label": "Task notes"
           },
           {
            "value": "open_tasks",
            "label": "Open tasks"
           },
           {
            "value": "notes",
            "label": "Notes"
           },
           {
            "value": "habits",
            "label": "Habits"
           }
          ]
         },
         {
          "type": "text-field",
          "name": "model",
          "label": "Model",
          "value": "{{row.model}}",
          "placeholder": "Blank: the one in Settings → AI"
         }
        ]
       },
       {
        "type": "stack",
        "direction": "row",
        "gap": 8,
        "wrap": true,
        "children": [
         {
          "type": "button",
          "if": "{{row.edited_builtin}}",
          "label": "Restore the starter",
          "icon": "repeat",
          "action": {
           "op": "delete_skill",
           "args": {
            "id": "{{row.id}}",
            "reset": true
           },
           "confirm": "Undo your changes to this starter?",
           "success": "{{result.message}}",
           "then": {
            "state.skill": ""
           }
          }
         },
         {
          "type": "button",
          "label": "{{row.delete_label}}",
          "icon": "trash",
          "variant": "danger",
          "action": {
           "op": "delete_skill",
           "args": {
            "id": "{{row.id}}"
           },
           "confirm": "Remove this skill? Reports made with it keep their text.",
           "success": "{{result.message}}",
           "then": {
            "state.skill": ""
           }
          }
         }
        ]
       }
      ]
     },
     {
      "type": "sheet",
      "bind": "state.newskill",
      "size": "large",
      "title": "New skill",
      "children": [
       {
        "type": "form",
        "submit_label": "Add skill",
        "submit": {
         "op": "save_skill",
         "args": {
          "id": "",
          "name": "{{form.name}}",
          "prompt": "{{form.prompt}}",
          "period": "{{form.period}}",
          "sources": "{{form.sources}}",
          "tags": "{{form.tags}}",
          "model": "{{form.model}}"
         },
         "success": "{{result.message}}",
         "then": {
          "state.newskill": ""
         }
        },
        "children": [
         {
          "type": "text-field",
          "name": "name",
          "label": "Name",
          "required": true,
          "value": "",
          "placeholder": "e.g. Update for my manager"
         },
         {
          "type": "text-area",
          "name": "prompt",
          "label": "What the AI should write",
          "rows": 9,
          "required": true,
          "value": "",
          "placeholder": "Who it is for, the sections, tone and length. The data comes from the report; the AI is told never to invent anything."
         },
         {
          "type": "stack",
          "direction": "row",
          "gap": 12,
          "wrap": true,
          "children": [
           {
            "type": "select",
            "name": "period",
            "label": "Usual range",
            "value": "",
            "options": [
             {
              "value": "",
              "label": "This week so far"
             },
             {
              "value": "last_week",
              "label": "Last week"
             },
             {
              "value": "7d",
              "label": "Last 7 days"
             },
             {
              "value": "month",
              "label": "This month so far"
             },
             {
              "value": "last_month",
              "label": "Last month"
             }
            ],
            "grow": 1,
            "basis": 180
           },
           {
            "type": "text-field",
            "name": "tags",
            "label": "Only tasks tagged",
            "value": "",
            "placeholder": "Blank: all",
            "grow": 1,
            "basis": 180
           }
          ]
         },
         {
          "type": "choice",
          "name": "sources",
          "label": "Data it uses",
          "multiple": true,
          "value": "tasks,task_notes",
          "options": [
           {
            "value": "tasks",
            "label": "Done tasks"
           },
           {
            "value": "task_notes",
            "label": "Task notes"
           },
           {
            "value": "open_tasks",
            "label": "Open tasks"
           },
           {
            "value": "notes",
            "label": "Notes"
           },
           {
            "value": "habits",
            "label": "Habits"
           }
          ]
         },
         {
          "type": "text-field",
          "name": "model",
          "label": "Model",
          "value": "",
          "placeholder": "Blank: the one in Settings → AI"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "stack",
    "if": "{{state.tab == schedules}}",
    "gap": 16,
    "children": [
     {
      "type": "stack",
      "direction": "row",
      "align": "center",
      "justify": "between",
      "wrap": true,
      "gap": 12,
      "children": [
       {
        "type": "text",
        "tone": "muted",
        "text": "Reports made on a schedule, on whichever of your devices is open then (phones only while the app is open). Run history and retries are in Settings → Scheduled; the weekly review without AI runs Sundays at 18:00 and can be changed there.",
        "grow": 1,
        "basis": 260
       },
       {
        "type": "button",
        "label": "New schedule",
        "icon": "plus",
        "variant": "primary",
        "action": {
         "set": {
          "state.newschedule": "1"
         }
        }
       }
      ]
     },
     {
      "type": "list",
      "query": "schedules",
      "empty": "No schedules yet.",
      "item": {
       "type": "item",
       "title": "{{row.name}}",
       "subtitle": "{{row.subtitle}}",
       "action": {
        "set": {
         "state.schedule": "{{row.id}}"
        }
       },
       "chips": [
        {
         "text": "{{row.status_chip}}",
         "tone": "{{row.status_tone}}",
         "icon": "clock"
        }
       ],
       "trailing": [
        {
         "type": "button",
         "label": "Run now",
         "variant": "ghost",
         "aria_label": "Run {{row.name}} now",
         "action": {
          "op": "run_schedule",
          "args": {
           "id": "{{row.id}}"
          },
          "success": "{{result.message}}"
         }
        }
       ]
      }
     },
     {
      "type": "sheet",
      "bind": "state.schedule",
      "title": "Schedule",
      "query": "schedule",
      "params": {
       "id": "{{state.schedule}}"
      },
      "refresh": true,
      "children": [
       {
        "type": "text",
        "if": "{{row.last_error}}",
        "tone": "danger",
        "text": "Last run: {{row.last_error}}"
       },
       {
        "type": "form",
        "submit_label": "Save",
        "submit": {
         "op": "save_schedule",
         "args": {
          "id": "{{row.id}}",
          "name": "{{form.name}}",
          "skill": "{{form.skill}}",
          "period": "{{form.period}}",
          "every": "{{form.every}}",
          "at": "{{form.at}}",
          "day": "{{form.day}}",
          "days": "{{form.days}}",
          "sources": "{{form.sources}}",
          "tags": "{{form.tags}}"
         },
         "success": "{{result.message}}",
         "then": {
          "state.schedule": ""
         }
        },
        "children": [
         {
          "type": "text-field",
          "name": "name",
          "label": "Name",
          "required": true,
          "value": "{{row.name}}",
          "placeholder": "e.g. Friday update for my manager"
         },
         {
          "type": "select",
          "name": "skill",
          "label": "Report template",
          "value": "{{row.skill}}",
          "options": [
           {
            "value": "none",
            "label": "No AI: numbers only"
           },
           {
            "value": "custom",
            "label": "AI, with one-off instructions"
           }
          ],
          "options_query": {
           "query": "skill_options",
           "value": "id",
           "label": "name"
          }
         },
         {
          "type": "select",
          "name": "period",
          "label": "Dates",
          "value": "{{row.period}}",
          "options": [
           {
            "value": "week",
            "label": "This week so far"
           },
           {
            "value": "last_week",
            "label": "Last week"
           },
           {
            "value": "7d",
            "label": "Last 7 days"
           },
           {
            "value": "month",
            "label": "This month so far"
           },
           {
            "value": "last_month",
            "label": "Last month"
           }
          ]
         },
         {
          "type": "stack",
          "direction": "row",
          "gap": 12,
          "wrap": true,
          "children": [
           {
            "type": "select",
            "name": "every",
            "label": "Repeat",
