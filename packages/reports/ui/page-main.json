          "placeholder": "Blank: all"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "sheet",
    "bind": "state.open",
    "size": "large",
    "refresh": true,
    "title": "{{row.title}}",
    "query": "report",
    "params": {
     "id": "{{state.open}}",
     "today": "{{$today}}"
    },
    "children": [
     {
      "type": "text",
      "tone": "muted",
      "text": "{{row.info}}"
     },
     {
      "type": "text",
      "if": "{{row.has_ai}}",
      "tone": "muted",
      "text": "{{row.draft_note}}"
     },
     {
      "type": "ai-status",
      "if": "{{row.has_ai}}",
      "model": "{{row.model}}"
     },
     {
      "type": "markdown",
      "if": "{{row.has_draft}}",
      "text": "{{row.draft}}"
     },
     {
      "type": "stack",
      "if": "{{row.has_ai}}",
      "direction": "row",
      "gap": 8,
      "wrap": true,
      "children": [
       {
        "type": "button",
        "if": "{{row.can_send}}",
        "label": "{{row.send_label}}",
        "icon": "sparkle",
        "variant": "primary",
        "action": {
         "op": "send",
         "args": {
          "id": "{{row.id}}"
         },
         "success": "{{result.message}}"
        }
       },
       {
        "type": "button",
        "if": "{{row.can_rewrite}}",
        "label": "Write again",
        "icon": "repeat",
        "action": {
         "op": "send",
         "args": {
          "id": "{{row.id}}"
         },
         "confirm": "Write it again? The current text is replaced.",
         "success": "{{result.message}}"
        }
       }
      ]
     },
     {
      "type": "section",
      "title": "Ask for changes",
      "collapsible": true,
      "if": "{{row.has_draft}}",
      "children": [
       {
        "type": "form",
        "submit_label": "Rewrite with changes",
        "submit": {
         "op": "send",
         "args": {
          "id": "{{row.id}}",
          "feedback": "{{form.feedback}}"
         },
         "success": "{{result.message}}"
        },
        "children": [
         {
          "type": "text-area",
          "name": "feedback",
          "label": "What should change?",
          "rows": 3,
          "placeholder": "e.g. Shorter. Lead with blockers. Drop the habits part."
         }
        ]
       }
      ]
     },
     {
      "type": "section",
      "title": "Edit the text",
      "collapsible": true,
      "if": "{{row.has_draft}}",
      "children": [
       {
        "type": "form",
        "submit_label": "Save text",
        "submit": {
         "op": "edit_draft",
         "args": {
          "id": "{{row.id}}",
          "draft": "{{form.draft}}"
         },
         "success": "Saved"
        },
        "children": [
         {
          "type": "text-area",
          "name": "draft",
          "label": "Report",
          "label_hidden": true,
          "rows": 14,
          "value": "{{row.draft}}"
         }
        ]
       }
      ]
     },
     {
      "type": "section",
      "title": "What is sent to AI",
      "collapsible": true,
      "if": "{{row.has_ai}}",
      "open": "{{row.draft_status == ready}}",
      "children": [
       {
        "type": "text",
        "tone": "muted",
        "text": "Data: {{row.sources_label}}. Tasks tagged #private are never sent."
       },
       {
        "type": "markdown",
        "text": "{{row.facts}}"
       },
       {
        "type": "section",
        "title": "Instructions",
        "collapsible": true,
        "children": [
         {
          "type": "text",
          "text": "{{row.prompt}}"
         }
        ]
       }
      ]
     },
     {
      "type": "stack",
      "direction": "row",
      "gap": 20,
      "wrap": true,
      "children": [
       {
        "type": "stat",
        "label": "Tasks done",
        "value": "{{row.tasks_done}}",
        "note": "{{row.tasks_note}}",
        "tone": "{{row.tasks_tone}}"
       },
       {
        "type": "stat",
        "if": "{{row.has_habits}}",
        "label": "Habits kept",
        "value": "{{row.habits_value}}",
        "note": "{{row.habits_note}}",
        "tone": "{{row.habits_tone}}"
       },
       {
        "type": "stat",
        "label": "New notes",
        "value": "{{row.notes_count}}",
        "note": "{{row.notes_note}}",
        "tone": "{{row.notes_tone}}"
       },
       {
        "type": "stat",
        "label": "Notes edited",
        "value": "{{row.notes_edited}}"
       }
      ]
     },
     {
      "type": "markdown",
      "if": "{{!row.detailed}}",
      "text": "{{row.summary}}"
     },
     {
      "type": "section",
      "title": "Tasks per day",
      "if": "{{row.detailed}}",
      "children": [
       {
        "type": "bar",
        "layout": "columns",
        "query": "daily",
        "params": {
         "id": "{{state.open}}"
        },
        "label": "label",
        "value": "count",
        "title": "title"
       }
      ]
     },
     {
      "type": "list",
      "query": "highlights",
      "layout": "plain",
      "params": {
       "id": "{{state.open}}"
      },
      "item": {
       "type": "text",
       "text": "{{row.text}}"
      }
     },
     {
      "type": "section",
      "title": "Habits",
      "if": "{{row.has_habits}}",
      "children": [
       {
        "type": "bar",
        "query": "habits",
        "params": {
         "id": "{{state.open}}"
        },
        "label": "title",
        "value": "rate",
        "max": 100,
        "value_label": "label"
       }
      ]
     },
     {
      "type": "section",
      "title": "Tags",
      "if": "{{row.has_tags}}",
      "children": [
       {
        "type": "list",
        "query": "tags",
        "layout": "chips",
        "params": {
         "id": "{{state.open}}"
        },
        "item": {
         "type": "badge",
         "text": "{{row.label}}"
        }
       }
      ]
     },
     {
      "type": "section",
      "title": "Completed tasks",
      "collapsible": true,
      "if": "{{row.detailed}}",
      "children": [
       {
        "type": "list",
        "query": "tasks",
        "group": "day",
        "params": {
         "id": "{{state.open}}"
        },
        "empty": "Nothing finished in this range.",
        "item": {
         "type": "item",
         "title": "{{row.title}}"
        }
       }
      ]
     },
     {
      "type": "section",
      "title": "New notes",
      "collapsible": true,
      "if": "{{row.notes_count}}",
      "children": [
       {
        "type": "list",
        "query": "notes",
        "params": {
         "id": "{{state.open}}"
        },
        "item": {
         "type": "item",
         "title": "{{row.title}}"
        }
       }
      ]
     },
     {
      "type": "section",
      "title": "Reflection",
      "children": [
       {
        "type": "form",
        "autosave": true,
        "submit": {
         "op": "reflect",
         "args": {
          "id": "{{row.id}}",
          "wins": "{{form.wins}}",
          "focus": "{{form.focus}}"
         }
        },
        "children": [
         {
          "type": "text-area",
          "name": "wins",
          "label": "What went well?",
          "rows": 3,
          "value": "{{row.wins}}",
          "placeholder": "Wins, small or big…"
         },
         {
          "type": "text-area",
          "name": "focus",
          "label": "What to focus on next?",
          "rows": 3,
          "value": "{{row.focus}}",
          "placeholder": "One or two things that matter most…"
         }
        ]
       }
      ]
     },
     {
      "type": "stack",
      "direction": "row",
      "gap": 8,
      "wrap": true,
      "children": [
       {
        "type": "button",
        "label": "Refresh data",
        "icon": "repeat",
        "variant": "primary",
        "action": {
         "op": "generate",
         "args": {
          "id": "{{row.id}}"
         },
         "success": "{{result.message}}"
        }
       },
       {
        "type": "button",
        "label": "Copy as Markdown",
        "icon": "note",
        "action": {
         "copy": "{{row.copy_text}}",
         "success": "Copied"
        }
       },
       {
        "type": "button",
        "label": "Delete",
        "icon": "trash",
        "variant": "danger",
        "action": {
         "op": "delete",
         "args": {
          "id": "{{row.id}}"
         },
         "confirm": "Delete this report? What you wrote in it goes too.",
         "success": "Deleted",
         "then": {
          "state.open": ""
         }
        }
       }
      ]
     }
    ]
   },
   {
    "type": "sheet",
    "bind": "state.create",
    "size": "large",
    "title": "Create report",
    "children": [
     {
      "type": "form",
      "submit_label": "Create report",
      "submit": {
       "op": "generate",
       "args": {
        "skill": "{{form.skill}}",
        "period": "{{form.period}}",
        "start": "{{form.start}}",
        "end": "{{form.end}}",
        "sources": "{{form.sources}}",
        "tags": "{{form.tags}}",
        "prompt": "{{form.prompt}}",
        "save_as": "{{form.save_as}}",
        "review": "{{form.review}}"
       },
       "success": "{{result.message}}",
       "then": {
        "state.create": "",
        "state.open": "{{result.id}}",
        "state.tab": "reports"
       }
      },
      "children": [
       {
        "type": "select",
        "name": "skill",
        "label": "Report template",
        "value": "{{state.create}}",
        "options": [
         {
          "value": "none",
          "label": "No AI: numbers only"
         },
         {
          "value": "custom",
          "label": "AI, with one-off instructions"
         }
        ],
        "options_query": {
         "query": "skill_options",
         "value": "id",
         "label": "name"
        }
       },
       {
        "type": "text",
        "if": "{{form.skill == none}}",
        "text": "Creates the usual task, note and habit statistics on this device. Nothing is sent to AI.",
        "muted": true
       },
       {
        "type": "stack",
        "direction": "row",
        "gap": 12,
        "wrap": true,
        "children": [
         {
          "type": "select",
          "name": "period",
          "label": "Dates",
          "value": "week",
          "options": [
           {
            "value": "week",
            "label": "This week so far"
           },
           {
            "value": "last_week",
            "label": "Last week"
           },
           {
            "value": "7d",
            "label": "Last 7 days"
           },
           {
            "value": "month",
            "label": "This month so far"
           },
           {
            "value": "last_month",
            "label": "Last month"
           },
           {
            "value": "custom",
            "label": "Custom dates"
           }
          ],
          "grow": 1,
          "basis": 200
         },
         {
          "type": "date",
          "name": "start",
          "label": "From",
          "grow": 1,
          "basis": 150,
          "if": "{{form.period == custom}}",
          "value": "{{$today}}"
         },
         {
          "type": "date",
          "name": "end",
          "label": "To",
          "grow": 1,
          "basis": 150,
          "if": "{{form.period == custom}}",
          "value": "{{$today}}"
         }
        ]
       },
       {
        "type": "choice",
        "name": "sources",
        "label": "Data to send",
        "multiple": true,
        "value": "tasks,task_notes,open_tasks,notes,habits",
        "options": [
         {
          "value": "tasks",
          "label": "Done tasks"
         },
         {
          "value": "task_notes",
          "label": "Task notes"
         },
         {
          "value": "open_tasks",
          "label": "Open tasks"
         },
         {
          "value": "notes",
          "label": "Notes"
         },
         {
          "value": "habits",
          "label": "Habits"
         }
        ],
        "if": "{{form.skill != none}}",
        "required": true
       },
       {
        "type": "text-field",
        "name": "tags",
        "label": "Only tasks tagged",
        "placeholder": "e.g. work, client (blank: all; #private is never sent)",
        "if": "{{form.skill != none}}"
       },
       {
        "type": "text-area",
        "name": "prompt",
        "label": "Writing instructions (optional with a template)",
        "rows": 4,
        "placeholder": "Needed for one-off instructions; with a skill, added to its prompt (e.g. “mention the launch first”)",
        "if": "{{form.skill != none}}"
       },
       {
        "type": "text-field",
        "name": "save_as",
        "label": "Save as a reusable template (optional)",
        "placeholder": "Optional",
        "if": "{{form.skill == custom}}"
       },
       {
        "type": "toggle",
        "name": "review",
        "label": "Let me check the data before it’s sent",
        "value": true,
        "if": "{{form.skill != none}}"
       },
       {
        "type": "text",
        "if": "{{form.skill != none}}",
        "text": "Only selected sources are sent. Tasks tagged #private are excluded. Check the exact data in the report before sending it. Configure your provider in Settings → AI.",
        "muted": true
       }
      ],
      "defaults": {
       "field": "skill",
       "query": "skill",
       "params": {
        "id": "{{form.skill}}"
       },
       "fields": {
        "period": "period",
        "sources": "sources",
        "tags": "tags"
       },
       "fallback": {
        "period": "week",
        "sources": "tasks,task_notes,open_tasks,notes,habits",
        "tags": ""
       }
      }
     }
    ]
   }
  ]
 }
}
