             },
             {
              "value": "month",
              "label": "Monthly"
             }
            ],
            "grow": 1,
            "basis": 150
           },
           {
            "type": "time",
            "name": "at",
            "label": "At",
            "value": "17:00",
            "grow": 1,
            "basis": 120
           },
           {
            "type": "text-field",
            "name": "day",
            "label": "Day of month (monthly)",
            "value": "1",
            "placeholder": "1–31 or last",
            "grow": 1,
            "basis": 150
           }
          ]
         },
         {
          "type": "choice",
          "name": "days",
          "label": "On (weekly)",
          "multiple": true,
          "value": "fri",
          "options": [
           {
            "value": "mon",
            "label": "Mon"
           },
           {
            "value": "tue",
            "label": "Tue"
           },
           {
            "value": "wed",
            "label": "Wed"
           },
           {
            "value": "thu",
            "label": "Thu"
           },
           {
            "value": "fri",
            "label": "Fri"
           },
           {
            "value": "sat",
            "label": "Sat"
           },
           {
            "value": "sun",
            "label": "Sun"
           }
          ]
         },
         {
          "type": "choice",
          "name": "sources",
          "label": "Data to send (none picked: the skill’s choice)",
          "multiple": true,
          "value": "",
          "options": [
           {
            "value": "tasks",
            "label": "Done tasks"
           },
           {
            "value": "task_notes",
            "label": "Task notes"
           },
           {
