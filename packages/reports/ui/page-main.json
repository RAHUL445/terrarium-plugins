         {
          "type": "choice",
          "name": "days",
          "label": "On (weekly)",
          "multiple": true,
          "value": "{{row.days}}",
          "options": [
           {
            "value": "mon",
            "label": "Mon"
           },
           {
            "value": "tue",
            "label": "Tue"
           },
           {
            "value": "wed",
            "label": "Wed"
           },
           {
            "value": "thu",
            "label": "Thu"
           },
           {
            "value": "fri",
            "label": "Fri"
           },
           {
            "value": "sat",
            "label": "Sat"
           },
           {
            "value": "sun",
            "label": "Sun"
           }
          ]
         },
         {
          "type": "choice",
          "name": "sources",
          "label": "Data to send (none picked: the skill’s choice)",
          "multiple": true,
          "value": "{{row.sources}}",
          "options": [
           {
            "value": "tasks",
            "label": "Done tasks"
           },
           {
            "value": "task_notes",
            "label": "Task notes"
           },
           {
            "value": "open_tasks",
            "label": "Open tasks"
           },
           {
            "value": "notes",
            "label": "Notes"
           },
           {
            "value": "habits",
            "label": "Habits"
           }
          ]
         },
         {
          "type": "text-field",
          "name": "tags",
          "label": "Only tasks tagged",
          "value": "{{row.tags}}",
          "placeholder": "Blank: all"
         }
        ]
       },
       {
        "type": "stack",
        "direction": "row",
        "gap": 8,
        "wrap": true,
        "children": [
         {
          "type": "button",
          "if": "{{row.last_report}}",
          "label": "Open last report",
          "action": {
           "set": {
            "state.schedule": "",
            "state.tab": "reports",
            "state.open": "{{row.last_report}}"
           }
          }
         },
         {
          "type": "button",
          "label": "{{row.toggle_label}}",
          "action": {
           "op": "toggle_schedule",
           "args": {
            "id": "{{row.id}}",
            "enabled": "{{!row.enabled}}"
           },
           "success": "{{result.message}}"
          }
         },
         {
          "type": "button",
          "label": "Delete",
          "icon": "trash",
          "variant": "danger",
          "action": {
           "op": "delete_schedule",
           "args": {
            "id": "{{row.id}}"
           },
           "confirm": "Remove this schedule? Reports it made stay.",
           "success": "{{result.message}}",
           "then": {
            "state.schedule": ""
           }
          }
         }
        ]
       }
      ]
     },
     {
      "type": "sheet",
      "bind": "state.newschedule",
      "title": "New schedule",
      "children": [
       {
        "type": "form",
        "submit_label": "Add schedule",
        "submit": {
         "op": "save_schedule",
         "args": {
          "id": "",
          "name": "{{form.name}}",
          "skill": "{{form.skill}}",
          "period": "{{form.period}}",
          "every": "{{form.every}}",
          "at": "{{form.at}}",
          "day": "{{form.day}}",
          "days": "{{form.days}}",
          "sources": "{{form.sources}}",
          "tags": "{{form.tags}}"
         },
         "success": "{{result.message}}",
         "then": {
          "state.newschedule": ""
